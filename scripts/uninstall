#!/bin/sh
# Removes a per-user installation made by scripts/install.
#
# Usage: scripts/uninstall [--purge]
#   --purge  also delete Plaud's data (~/.config/Plaud: account session,
#            settings, local recordings cache) and the Linux runtime state
#            (staged updates, logs of the update process).
set -eu

APP_ID=io.github.trukhinyuri.PlaudLinux
COMMAND=plaud-linux

data="${XDG_DATA_HOME:-$HOME/.local/share}"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
state="${XDG_STATE_HOME:-$HOME/.local/state}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
base="$data/$COMMAND"

if command -v pgrep >/dev/null 2>&1 && pgrep -f -- "$base/app/plaud-linux-bin" >/dev/null 2>&1; then
  echo "uninstall: Plaud is running; quit it (tray menu > Quit) first" >&2
  exit 1
fi

if [ -L "$HOME/.local/bin/$COMMAND" ]; then
  case "$(readlink -- "$HOME/.local/bin/$COMMAND")" in
    "$base"/*) rm -f "$HOME/.local/bin/$COMMAND" ;;
  esac
fi
# Staged updates are patched Plaud releases: they are part of the app.
rm -rf "$base/app" "$base/versions" "$base/.app-new."* "$base/.app-old"
rm -f "$data/applications/$APP_ID.desktop" "$data/metainfo/$APP_ID.metainfo.xml"
rm -f "$data"/icons/hicolor/*/apps/"$APP_ID.png"
# The app writes this entry when "launch at login" is enabled.
rm -f "$config/autostart/$APP_ID.desktop"

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$data/applications" || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t "$data/icons/hicolor" 2>/dev/null || true

if [ "${1:-}" = --purge ]; then
  rm -rf "$base" "$state/$COMMAND" "$cache/$COMMAND" "$config/Plaud" "$config/plaud-linux-flags.conf"
  echo "Removed Plaud (unofficial) and its data"
else
  rmdir "$base" 2>/dev/null || true
  echo "Removed Plaud (unofficial); data kept in $config/Plaud and $base (use --purge to delete)"
fi
