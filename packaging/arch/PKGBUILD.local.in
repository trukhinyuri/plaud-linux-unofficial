# Generated by scripts/package.js to package a local build (build/linux-*);
# see packaging/arch/PKGBUILD for the source-based PKGBUILD.
pkgname=@PACKAGE_NAME@
pkgver=@PKG_VERSION@
pkgrel=1
pkgdesc="@SUMMARY@"
arch=('@PACMAN_ARCH@')
url="@PROJECT_URL@"
license=('Apache-2.0' 'LicenseRef-Plaud-proprietary')
depends=(@DEPENDS@)
optdepends=(@OPTDEPENDS@)
options=(!strip !debug !emptydirs)

package() {
  cp -R --no-preserve=ownership --preserve=mode,timestamps,links "@STAGED_ROOT@/." "$pkgdir/"
  chmod 4755 "$pkgdir/opt/@COMMAND@/chrome-sandbox"
}
