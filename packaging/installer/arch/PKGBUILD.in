# Generated by scripts/package-installer.js: installer package for pacman.
# It contains only this project's code; the install script builds the app.
# For a package built entirely from source, use packaging/arch/PKGBUILD.
pkgname=@PACKAGE_NAME@
pkgver=@PKG_VERSION@
pkgrel=1
pkgdesc="@SUMMARY@ (installer)"
arch=('@PACMAN_ARCH@')
url="@PROJECT_URL@"
license=('Apache-2.0')
depends=(@DEPENDS@)
optdepends=(@OPTDEPENDS@)
conflicts=(@CONFLICTS@)
install=@PACKAGE_NAME@.install
options=(!strip !debug !emptydirs)

package() {
  cp -R --no-preserve=ownership --preserve=mode,timestamps,links "@STAGED_ROOT@/." "$pkgdir/"
}
